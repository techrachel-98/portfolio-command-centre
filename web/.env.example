# Copy to .env.local and fill in. Never commit .env.local.

# --- Content (Supabase) — public read of Projects & Education ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Admin panel (/admin) ---
# Your own password, 8+ characters. Unset or shorter = admin disabled.
ADMIN_PASSWORD=

# --- Job Match (Apify LinkedIn scraper) ---
# Leave blank to get labelled sample data instead of live results.
APIFY_TOKEN=
# Optional: use a different Apify actor (default: curious_coder~linkedin-jobs-scraper)
# APIFY_ACTOR_ID=

# --- Applied-jobs tracking (server-only secret; bypasses RLS) ---
SUPABASE_SERVICE_ROLE_KEY=
